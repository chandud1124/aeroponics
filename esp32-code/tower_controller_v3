unsigned long tsLastPumpRelaySwitch = 0;
unsigned long tsLastNutrARelaySwitch = 0;
unsigned long tsLastNutrBRelaySwitch = 0;
unsigned long tsLastPhDownRelaySwitch = 0;

void setRelayState(int pin, bool on) {
  unsigned long now = millis();
  unsigned long* lastSwitchMs = nullptr;
  
  if (pin == PIN_PUMP_RELAY) lastSwitchMs = &tsLastPumpRelaySwitch;
  else if (pin == PIN_NUTRITION_A_RELAY) lastSwitchMs = &tsLastNutrARelaySwitch;
  else if (pin == PIN_NUTRITION_B_RELAY) lastSwitchMs = &tsLastNutrBRelaySwitch;
  else if (pin == PIN_PH_DOWN_RELAY) lastSwitchMs = &tsLastPhDownRelaySwitch;
  
  // RELAY_ACTIVE_HIGH=false means LOW turns relay ON (standard opto-isolated board logic)
  bool currentState = (digitalRead(pin) == (RELAY_ACTIVE_HIGH ? HIGH : LOW));
  
  if (on != currentState) {
    // Enforce 5-second cooldown on ON transitions to protect contacts against rapid switching
    if (on && lastSwitchMs && (now - *lastSwitchMs < 5000UL)) {
      Serial.printf("[RELAY SAFETY] Cooldown active for pin %d. Blocking ON transition.\n", pin);
      return;
    }
    digitalWrite(pin, RELAY_ACTIVE_HIGH ? (on ? HIGH : LOW) : (on ? LOW : HIGH));
    if (lastSwitchMs) {
      *lastSwitchMs = now;
    }
  }
}

void setupPinModes() {
  pinMode(PIN_PUMP_RELAY,            OUTPUT);
  pinMode(PIN_NUTRITION_A_RELAY,     OUTPUT);
  pinMode(PIN_NUTRITION_B_RELAY,     OUTPUT);
  pinMode(PIN_PH_DOWN_RELAY,         OUTPUT);
  
  // Set relays off by default
  setRelayState(PIN_PUMP_RELAY,           false);
  setRelayState(PIN_NUTRITION_A_RELAY,    false);
  setRelayState(PIN_NUTRITION_B_RELAY,    false);
  setRelayState(PIN_PH_DOWN_RELAY,        false);

  pinMode(PIN_DHT_DATA,     INPUT_PULLUP);
  pinMode(PIN_PH_SENSOR,    INPUT);
  pinMode(PIN_EC_SENSOR,    INPUT);
  pinMode(PIN_LEVEL_SENSOR, INPUT_PULLUP);
