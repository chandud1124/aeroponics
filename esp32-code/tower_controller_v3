bool clampScheduleValues() {
  bool changed = false;
  auto clamp = [&](int& v, int lo, int hi) {
    if (v < lo) { v = lo; changed = true; }
    else if (v > hi) { v = hi; changed = true; }
  };
  clamp(schedule.intervalMinutes, 5,   1440);
  clamp(schedule.durationSeconds, 10,  600);
  clamp(schedule.startHour,       0,   23);
  clamp(schedule.endHour,         0,   24);
  clamp(schedule.lightStartHour,   0,   23);
  clamp(schedule.lightEndHour,     0,   24);
  clamp(schedule.dayIntervalMinutes,   5,   1440);
  clamp(schedule.dayDurationSeconds,   10,  600);
  clamp(schedule.nightIntervalMinutes,  5,   1440);
  clamp(schedule.nightDurationSeconds,  10,  600);
  if (schedule.endHour <= schedule.startHour) {
    schedule.endHour = min(schedule.startHour + 1, 24);
    changed = true;
  }
  if (schedule.lightEndHour <= schedule.lightStartHour) {
    schedule.lightEndHour = min(schedule.lightStartHour + 1, 24);
    changed = true;
  }
  return changed;
}

