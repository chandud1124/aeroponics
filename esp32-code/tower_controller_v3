bool clampScheduleValues() {
  bool changed = false;
  auto clamp = [&](int& v, int lo, int hi) {
    if (v < lo) { v = lo; changed = true; }
    else if (v > hi) { v = hi; changed = true; }
  };
  clamp(schedule.intervalMinutes, 5,   1440);
  clamp(schedule.durationSeconds, 10,  600);
  clamp(schedule.startHour,       0,   23);
  clamp(schedule.endHour,         0,   23);
  if (schedule.endHour <= schedule.startHour) {
    schedule.endHour = min(schedule.startHour + 1, 23);
    changed = true;
  }
  return changed;
}

void saveScheduleToNVS() {
  prefs.begin(NVS_NS, false);
  prefs.putInt(NVS_SCHED_INT, schedule.intervalMinutes);
  prefs.putInt(NVS_SCHED_DUR, schedule.durationSeconds);
  prefs.putInt(NVS_SCHED_SH,  schedule.startHour);
  prefs.putInt(NVS_SCHED_EH,  schedule.endHour);
  prefs.putBool(NVS_SCHED_EN, schedule.enabled);
  prefs.putULong(NVS_CHG_START, batteryChargeStartSec);
  prefs.putULong(NVS_CHG_DUR,   batteryChargeDurSec);
  prefs.end();
  Serial.printf("[NVS] Schedule saved: every %dmin for %ds (%02d:00–%02d:00)\n",
    schedule.intervalMinutes, schedule.durationSeconds,
    schedule.startHour, schedule.endHour);
}

void loadScheduleFromNVS() {
  prefs.begin(NVS_NS, true);
  schedule.intervalMinutes = prefs.getInt(NVS_SCHED_INT, 10);
  schedule.durationSeconds = prefs.getInt(NVS_SCHED_DUR, 180);
  schedule.startHour       = prefs.getInt(NVS_SCHED_SH,  0);
  schedule.endHour         = prefs.getInt(NVS_SCHED_EH,  24);
  schedule.enabled         = prefs.getBool(NVS_SCHED_EN, true);
  status.lastRunEpoch      = (time_t)prefs.getUInt(NVS_LAST_RUN, 0);
  batteryChargeStartSec    = prefs.getULong(NVS_CHG_START, 8UL * 3600UL);
  batteryChargeDurSec      = prefs.getULong(NVS_CHG_DUR,   4UL * 3600UL);
  // [FIX-12] This is where ntpSynced is correctly set from NVS — NOT at declaration
  ntpSynced                = prefs.getBool(NVS_TIME_VALID, false);
  prefs.end();

  if (clampScheduleValues()) {
    saveScheduleToNVS();
  }
  Serial.printf("[NVS] Schedule loaded: every %dmin for %ds (%02d:00–%02d:00)\n",
    schedule.intervalMinutes, schedule.durationSeconds,
    schedule.startHour, schedule.endHour);
}

