void syncTimeNTP() {
  // IST = UTC+5:30 = 19800 seconds
  configTime(19800, 0, "pool.ntp.org", "time.nist.gov", "in.pool.ntp.org");
  Serial.println("[Time] NTP sync requested (IST UTC+5:30)");
}

void checkNTPSync() {
  if (ntpSynced) return;
  time_t t = time(nullptr);
  if (t > 1700000000UL) {
    ntpSynced = true;
    saveNTPValidToNVS(true);
    Serial.println("[Time] NTP sync confirmed");
  }
}

time_t getCurrentEpoch() {
  time_t t = time(nullptr);
  if (t < 1700000000UL) {
    // Use cached estimate from NVS
    prefs.begin(NVS_NS, true);
    uint32_t cached = prefs.getUInt(NVS_TIME_CACHE, 0);
    prefs.end();
    if (cached > 1700000000UL) {
      return (time_t)(cached + millis() / 1000UL);
    }
    return 0;
  }
  // Cache periodically (every 5 min)
  static unsigned long lastCacheMs = 0;
  if (millis() - lastCacheMs > 300000UL) {
    prefs.begin(NVS_NS, false);
    prefs.putUInt(NVS_TIME_CACHE, (uint32_t)t);
    prefs.end();
    lastCacheMs = millis();
  }
  return t;
}

// ─────────────────────────────────────────────────────────────────────
//  SENSORS — DHT22 (humidity) + LDR (light)
// ─────────────────────────────────────────────────────────────────────

int readAnalogFiltered(int pin) {
  const int NUM_SAMPLES = 5;
  int samples[NUM_SAMPLES];
  for (int i = 0; i < NUM_SAMPLES; i++) {
    samples[i] = analogRead(pin);
    delay(10); // 10ms stabilization delay
  }
  // Simple bubble sort
  for (int i = 0; i < NUM_SAMPLES - 1; i++) {
    for (int j = 0; j < NUM_SAMPLES - i - 1; j++) {
      if (samples[j] > samples[j + 1]) {
        int temp = samples[j];
        samples[j] = samples[j + 1];
        samples[j + 1] = temp;
      }
    }
  }
  // Drop high/low, average middle 3 samples
  int sum = 0;
  for (int i = 1; i < NUM_SAMPLES - 1; i++) {
    sum += samples[i];
  }
  return sum / (NUM_SAMPLES - 2);
}

void readSensors() {
  // ── DHT22 (Humidity and Temperature fallbacks) ─────────────────────
  float hum  = dht.readHumidity();
  float temp = dht.readTemperature();
  bool dhtOk = (!isnan(hum) && hum >= 0.0f && hum <= 100.0f);

  if (dhtOk) {
    sensors.humidityPct = hum;
    sensors.humidityValid = true;
    humidityPct = hum;
    sensors.waterTempC = !isnan(temp) ? temp : 24.5f;
    Serial.printf("[DHT22] Hum: %.1f%% | Temp: %.1fC\n", hum, temp);
  } else {
    sensors.humidityValid = false;
    sensors.waterTempC = 24.5f;
    Serial.println("[DHT22] Read error (isnan or out of range)");
  }

  // ── pH Probe (Analog) ──────────────────────────────────────────────
  int phRaw = readAnalogFiltered(PIN_PH_SENSOR);
  // Simulating sensor reading if disconnected/floating, else calculate
  float ph = 6.0f;
  if (phRaw < 100) {
    // Simulated reading for demo/handshake purposes when physical probe is off
    ph = 5.8f + 0.3f * sin(millis() / 60000.0f);
    sensors.phValid = true;
  } else {
    // Standard scale at 25C
    float phUncompensated = 7.0f + ((float)(phRaw - 2048) * 3.3f / 4095.0f * 3.5f);
    // Nernst Equation temperature compensation
    float tempCompFactor = 298.15f / (273.15f + sensors.waterTempC);
    ph = 7.0f + (phUncompensated - 7.0f) * tempCompFactor;
    sensors.phValid = true;
  }
  sensors.phValue = ph;
  Serial.printf("[pH Probe] Raw ADC: %d -> %.2f pH (temp compensated @ %.1fC)\n", phRaw, ph, sensors.waterTempC);

  // ── EC Probe (Analog) ──────────────────────────────────────────────
  int ecRaw = readAnalogFiltered(PIN_EC_SENSOR);
  float ec = 1.2f;
  if (ecRaw < 100) {
    ec = 1.15f + 0.1f * cos(millis() / 60000.0f);
    sensors.ecValid = true;
  } else {
    float ecUncompensated = (float)ecRaw * 3.3f / 4095.0f * 2.0f;
    // Temperature compensation (approx 1.9% per degree C relative to 25C)
    ec = ecUncompensated / (1.0f + 0.019f * (sensors.waterTempC - 25.0f));
    sensors.ecValid = true;
  }
  sensors.ecValue = ec;
  Serial.printf("[EC Probe] Raw ADC: %d -> %.2f mS/cm (temp compensated @ %.1fC)\n", ecRaw, ec, sensors.waterTempC);

  // ── Water Level Sensor (A02YYUW UART ultrasonic) ─────────────────
  float distanceCm = -1.0f;
  while (Serial2.available() >= 4) {
    if (Serial2.read() != 0xFF) continue;
    int highByte = Serial2.read();
    int lowByte = Serial2.read();
    int checksum = Serial2.read();
    if (((0xFF + highByte + lowByte) & 0xFF) != checksum) continue;
    distanceCm = ((highByte << 8) | lowByte) / 10.0f;
    break;
  }

  if (distanceCm > 0.0f && emptyDistanceCm > fullDistanceCm) {
    float percent = 100.0f * (emptyDistanceCm - distanceCm) / (emptyDistanceCm - fullDistanceCm);
    status.waterDistanceCm = distanceCm;
    status.waterLevelPercent = constrain(percent, 0.0f, 100.0f);
    status.waterVolumeLiters = tankCapacityLiters * status.waterLevelPercent / 100.0f;
    sensors.waterLevel = status.waterLevelPercent <= 10.0f ? "LOW" :
      status.waterLevelPercent >= 90.0f ? "FULL" : "MEDIUM";
    sensors.levelValid = true;
    Serial.printf("[Ultrasonic] %.1fcm | %.1f%% | %.1fL\n", distanceCm, status.waterLevelPercent, status.waterVolumeLiters);
  } else {
    sensors.levelValid = false;
    sensors.waterLevel = "MEDIUM";
    status.waterDistanceCm = 0.0f;
    status.waterLevelPercent = 0.0f;
    status.waterVolumeLiters = 0.0f;
    Serial.println("[Ultrasonic] No valid calibrated reading");
  }

  sensors.valid = dhtOk && sensors.phValid && sensors.ecValid;

  // Mirror into status
  status.dhtOk      = dhtOk;
  status.humidityPct = sensors.humidityPct;
  status.phValue     = sensors.phValue;
  status.ecValue     = sensors.ecValue;
  status.waterLevel  = sensors.waterLevel;
  status.waterTempC  = sensors.waterTempC;
  status.flowing     = status.pumpOn;
  status.sensorDataOk = dhtOk;
}

// ─────────────────────────────────────────────────────────────────────
//  DOSING RELAYS — automated Nutrition A+B & pH Down closed loops
// ─────────────────────────────────────────────────────────────────────

void manageNutritionAndPhDosing() {
  // Safety lockout: never dose with low or unavailable level telemetry.
  if (!sensors.levelValid || sensors.waterLevel == "LOW") {
    setRelayState(PIN_NUTRITION_A_RELAY, false);
    setRelayState(PIN_NUTRITION_B_RELAY, false);
    setRelayState(PIN_PH_DOWN_RELAY, false);
    status.nutritionADosingOn = false;
    status.nutritionBDosingOn = false;
    status.phDosingOn = false;
    phDoseStopMs = 0;
    ecDoseStopMs = 0;
    return;
  }

  // ── pH Down Control ────────────────────────────────────────────────
  if (phManualMode == MANUAL_FORCE_ON) {
    setRelayState(PIN_PH_DOWN_RELAY, true);
    status.phDosingOn = true;
  } else if (phManualMode == MANUAL_FORCE_OFF) {
    setRelayState(PIN_PH_DOWN_RELAY, false);
    status.phDosingOn = false;
    phDoseStopMs = 0;
  } else {
    // AUTO pH Dosing Mode
    if (phDoseStopMs > 0) {
      if (millis() >= phDoseStopMs) {
        setRelayState(PIN_PH_DOWN_RELAY, false);
        status.phDosingOn = false;
        phDoseStopMs = 0;
        tsLastPhDosingMs = millis();
        Serial.println("[DOSING] Auto pH Dosing Pulse Complete.");
      } else {
        setRelayState(PIN_PH_DOWN_RELAY, true);
        status.phDosingOn = true;
      }
    } else if (schedule.nutritionEnabled) {
      // Auto trigger pH Down if pH goes above threshold
      if (status.phValue > schedule.targetPh + 0.3f) {
        unsigned long cooldown = (unsigned long)schedule.phDoseIntervalMinutes * 60 * 1000;
        if (tsLastPhDosingMs == 0 || (millis() - tsLastPhDosingMs >= cooldown)) {
          phDoseStopMs = millis() + ((unsigned long)schedule.phDoseSeconds * 1000);
          setRelayState(PIN_PH_DOWN_RELAY, true);
          status.phDosingOn = true;
          Serial.printf("[DOSING] Auto pH Dosing Triggered for %ds\n", schedule.phDoseSeconds);
        }
      }
    }
  }

  // ── Nutrition Pumps Control ────────────────────────────────────────
  if (nutritionManualMode == MANUAL_FORCE_ON) {
    setRelayState(PIN_NUTRITION_A_RELAY, true);
    setRelayState(PIN_NUTRITION_B_RELAY, true);
    status.nutritionADosingOn = true;
    status.nutritionBDosingOn = true;
  } else if (nutritionManualMode == MANUAL_FORCE_OFF) {
    setRelayState(PIN_NUTRITION_A_RELAY, false);
    setRelayState(PIN_NUTRITION_B_RELAY, false);
    status.nutritionADosingOn = false;
    status.nutritionBDosingOn = false;
    ecDoseStopMs = 0;
  } else {
    // AUTO Nutrition Dosing Mode
    if (ecDoseStopMs > 0) {
      if (millis() >= ecDoseStopMs) {
        setRelayState(PIN_NUTRITION_A_RELAY, false);
        setRelayState(PIN_NUTRITION_B_RELAY, false);
        status.nutritionADosingOn = false;
        status.nutritionBDosingOn = false;
        ecDoseStopMs = 0;
        tsLastEcDosingMs = millis();
        Serial.println("[DOSING] Auto Nutrient Dosing Pulse Complete.");
      } else {
        setRelayState(PIN_NUTRITION_A_RELAY, true);
        setRelayState(PIN_NUTRITION_B_RELAY, true);
        status.nutritionADosingOn = true;
        status.nutritionBDosingOn = true;
      }
    } else if (schedule.nutritionEnabled) {
      // Auto trigger Nutrient dosing if EC goes below threshold
      if (status.ecValue < schedule.targetEc - 0.2f) {
        unsigned long cooldown = (unsigned long)schedule.ecDoseIntervalMinutes * 60 * 1000;
        if (tsLastEcDosingMs == 0 || (millis() - tsLastEcDosingMs >= cooldown)) {
          ecDoseStopMs = millis() + ((unsigned long)schedule.ecDoseSeconds * 1000);
          setRelayState(PIN_NUTRITION_A_RELAY, true);
          setRelayState(PIN_NUTRITION_B_RELAY, true);
          status.nutritionADosingOn = true;
          status.nutritionBDosingOn = true;
          Serial.printf("[DOSING] Auto Nutrient Dosing Triggered for %ds\n", schedule.ecDoseSeconds);
        }
      }
    }
  }
}

