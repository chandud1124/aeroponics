// ─────────────────────────────────────────────────────────────────────
//  OFFLINE LOG QUEUE
// ─────────────────────────────────────────────────────────────────────

int getOfflineLogCount() {
  prefs.begin(NVS_NS, true);
  int n = prefs.getInt(NVS_LOG_COUNT, 0);
  prefs.end();
  return min(n, OFFLINE_LOG_MAX);
}

void pushOfflineLog(LogEntry& entry) {
  prefs.begin(NVS_NS, false);
  int n = prefs.getInt(NVS_LOG_COUNT, 0);
  if (n >= OFFLINE_LOG_MAX) {
    // Shift queue — discard oldest entry
    for (int i = 0; i < n - 1; i++) {
      char kFrom[12], kTo[12];
      snprintf(kFrom, sizeof(kFrom), "log%d", i + 1);
      snprintf(kTo,   sizeof(kTo),   "log%d", i);
      LogEntry tmp;
      if (prefs.getBytes(kFrom, &tmp, sizeof(LogEntry)) == sizeof(LogEntry))
        prefs.putBytes(kTo, &tmp, sizeof(LogEntry));
    }
    n--;
  }
  char key[12];
  snprintf(key, sizeof(key), "log%d", n);
  size_t written = prefs.putBytes(key, &entry, sizeof(LogEntry));
  if (written == sizeof(LogEntry)) prefs.putInt(NVS_LOG_COUNT, n + 1);
  else Serial.println("[LOG] ✗ NVS write failed for log entry");
  prefs.end();
}

void flushOfflineLogQueue() {
  if (!wifiConnected) return;
  int n = getOfflineLogCount();
  if (n == 0) return;

  Serial.printf("[LOG] Flushing %d offline entries...\n", n);
  int sent = 0;
  for (int i = 0; i < n; i++) {
    char key[12];
    snprintf(key, sizeof(key), "log%d", i);
    prefs.begin(NVS_NS, true);
    LogEntry entry;
    size_t len = prefs.getBytes(key, &entry, sizeof(LogEntry));
    prefs.end();
    if (len != sizeof(LogEntry)) continue;
    if (postLogEntryToAPI(entry)) sent++;
    else break; // Stop if backend is unreachable
  }

  if (sent > 0) {
    prefs.begin(NVS_NS, false);
    int remaining = n - sent;
    for (int i = 0; i < remaining; i++) {
      char kFrom[12], kTo[12];
      snprintf(kFrom, sizeof(kFrom), "log%d", i + sent);
      snprintf(kTo,   sizeof(kTo),   "log%d", i);
      LogEntry tmp;
      if (prefs.getBytes(kFrom, &tmp, sizeof(LogEntry)) == sizeof(LogEntry))
        prefs.putBytes(kTo, &tmp, sizeof(LogEntry));
    }
    prefs.putInt(NVS_LOG_COUNT, remaining);
    prefs.end();
    Serial.printf("[LOG] Flushed %d / %d entries.\n", sent, n);
  }
}

// ─────────────────────────────────────────────────────────────────────
//  WiFi — NON-BLOCKING WITH EXPONENTIAL BACKOFF
// ─────────────────────────────────────────────────────────────────────

void initWiFi() {
  WiFi.mode(WIFI_STA);
  WiFi.persistent(false);
  WiFi.setSleep(false);
  WiFi.setAutoReconnect(false);
  WiFi.setTxPower(WIFI_POWER_11dBm);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  tsLastWifiAttempt = millis();
  Serial.printf("[WiFi] Connecting to '%s'...\n", WIFI_SSID);
}

void IRAM_ATTR flowPulseISR() {
  flowPulseCount++;
  lastFlowPulseMs = millis();
}

void maintainWiFi(unsigned long now) {
  if (now - tsLastWifiCheck < IV_WIFI_CHECK) return;
  tsLastWifiCheck = now;

  bool connected = (WiFi.status() == WL_CONNECTED);

  if (connected && !wifiConnected) {
    wifiConnected = true;
    wifiBackoffMs = 5000UL;  // Reset backoff on success
    Serial.print("[WiFi] Connected: ");
    Serial.println(WiFi.localIP());
    // Sync time as soon as we have network
    syncTimeNTP();
    // Immediate status post + sensor read on reconnect
    readSensors();
    postStatus();
    tsLastStatusPost = now;
  } else if (!connected && wifiConnected) {
    wifiConnected = false;
    Serial.println("[WiFi] Disconnected — offline mode");
  }

  if (!connected && (now - tsLastWifiAttempt >= wifiBackoffMs)) {
    Serial.printf("[WiFi] Reconnecting (backoff %lus)...\n", wifiBackoffMs / 1000);
    WiFi.disconnect(false, false);
    WiFi.begin(WIFI_SSID, WIFI_PASS);
    tsLastWifiAttempt = now;
    wifiBackoffMs = min(wifiBackoffMs * 2, WIFI_BACKOFF_MAX);
  }
}

// ─────────────────────────────────────────────────────────────────────
//  TIME MANAGEMENT
// ─────────────────────────────────────────────────────────────────────

void syncTimeNTP() {
  // IST = UTC+5:30 = 19800 seconds
  configTime(19800, 0, "pool.ntp.org", "time.nist.gov", "in.pool.ntp.org");
  Serial.println("[Time] NTP sync requested (IST UTC+5:30)");
}

void checkNTPSync() {
  if (ntpSynced) return;
  time_t t = time(nullptr);
  if (t > 1700000000UL) {
    ntpSynced = true;
    saveNTPValidToNVS(true);
    Serial.println("[Time] NTP sync confirmed");
  }
}

time_t getCurrentEpoch() {
  time_t t = time(nullptr);
  if (t < 1700000000UL) {
    // Use cached estimate from NVS
    prefs.begin(NVS_NS, true);
    uint32_t cached = prefs.getUInt(NVS_TIME_CACHE, 0);
    prefs.end();
    if (cached > 1700000000UL) {
      return (time_t)(cached + millis() / 1000UL);
    }
    return 0;
  }
  // Cache periodically (every 5 min)
  static unsigned long lastCacheMs = 0;
  if (millis() - lastCacheMs > 300000UL) {
    prefs.begin(NVS_NS, false);
    prefs.putUInt(NVS_TIME_CACHE, (uint32_t)t);
    prefs.end();
    lastCacheMs = millis();
  }
  return t;
}

// ─────────────────────────────────────────────────────────────────────
//  SENSORS — DHT22 (humidity + temperature) + LDR (light)
// ─────────────────────────────────────────────────────────────────────

void readSensors() {
  // ── DHT22 ──────────────────────────────────────────────────────────
  float hum  = dht.readHumidity();
  float temp = dht.readTemperature();   // [FIX-9] Read temperature too

  bool dhtOk = (!isnan(hum) && !isnan(temp) &&
                hum  >= 0.0f  && hum  <= 100.0f &&
                temp > -40.0f && temp < 85.0f);

  if (dhtOk) {
    sensors.humidityPct = hum;
    sensors.airTempC    = temp;
    Serial.printf("[DHT22] Hum: %.1f%%  Temp: %.1f°C\n", hum, temp);
  } else {
    Serial.println("[DHT22] Read error (isnan or out of range)");
  }

  // ── LDR ────────────────────────────────────────────────────────────
  int ldrRaw = analogRead(PIN_LDR_SENSOR);
  // If LDR reads below minimum valid threshold, sensor may be disconnected
  bool ldrValid = (ldrRaw >= LDR_MIN_VALID);
  if (ldrValid) {
    sensors.lightRaw = ldrRaw;
    // [FIX-7] isDark = raw ADC below threshold (higher raw = darker with pull-down)
    sensors.isDark   = (ldrRaw < LDR_DARK_THRESHOLD);
    Serial.printf("[LDR] Raw: %d  isDark: %s\n",
                  ldrRaw, sensors.isDark ? "yes" : "no");
  } else {
    Serial.printf("[LDR] Possibly disconnected (raw=%d)\n", ldrRaw);
    // Don't update sensors.isDark — keep last known value
  }

  sensors.valid = dhtOk;

  // Mirror into status
  status.dhtOk      = dhtOk;
  status.humidityPct = sensors.humidityPct;
  status.airTempC    = sensors.airTempC;    // [FIX-9]
  status.lightRaw    = sensors.lightRaw;
  status.lightDark   = sensors.isDark;      // [FIX-7]

  // ── DS18B20 non-blocking conversion ─────────────────────────────
  unsigned long nowMs = millis();
  if (!pendingTempRequest && nowMs >= ds18b20RetryAfterMs) {
    // Request conversion on both sensors (non-blocking)
    resTempSensor.requestTemperatures();
    towerTempSensor.requestTemperatures();
    pendingTempRequest = true;
    tsTempRequestMs = nowMs;
  } else if (pendingTempRequest) {
    if (nowMs - tsTempRequestMs > 2500UL) {
      pendingTempRequest = false;
      ds18b20FailureStreak++;
      if (!reservoirDsMissingLogged || !towerDsMissingLogged || ds18b20FailureStreak == 1) {
        Serial.println("[SENSOR] DS18B20 conversion timed out; retrying later");
      }
      if (ds18b20FailureStreak >= 3) {
        ds18b20RetryAfterMs = nowMs + 300000UL;
        ds18b20FailureStreak = 0;
        Serial.println("[SENSOR] DS18B20 unavailable; pausing retries for 5 minutes");
      }
    } else if (nowMs - tsTempRequestMs >= 700UL) {
      float r = resTempSensor.getTempCByIndex(0);
      float t = towerTempSensor.getTempCByIndex(0);

      if (r != DEVICE_DISCONNECTED_C) {
        reservoirTempC = r;
        if (reservoirDsMissingLogged) {
          Serial.println("[SENSOR] Reservoir DS18B20 recovered");
          reservoirDsMissingLogged = false;
        }
      } else {
        if (!reservoirDsMissingLogged) {
          Serial.println("[SENSOR] Reservoir DS18B20 missing or unreadable; continuing");
          reservoirDsMissingLogged = true;
        }
        reservoirTempC = NAN;
      }

      if (t != DEVICE_DISCONNECTED_C) {
        towerTempC = t;
        if (towerDsMissingLogged) {
          Serial.println("[SENSOR] Tower DS18B20 recovered");
          towerDsMissingLogged = false;
        }
      } else {
        if (!towerDsMissingLogged) {
          Serial.println("[SENSOR] Tower DS18B20 missing or unreadable; continuing");
          towerDsMissingLogged = true;
        }
        towerTempC = NAN;
      }

      if (r == DEVICE_DISCONNECTED_C && t == DEVICE_DISCONNECTED_C) {
        ds18b20FailureStreak++;
        if (ds18b20FailureStreak >= 3) {
          ds18b20RetryAfterMs = nowMs + 300000UL;
          ds18b20FailureStreak = 0;
          Serial.println("[SENSOR] DS18B20 unavailable; pausing retries for 5 minutes");
        }
      } else {
        ds18b20FailureStreak = 0;
      }

      pendingTempRequest = false;
    }
  }

  // ── Flow sensor sampling (compute LPM)
  unsigned long sampleNow = millis();
  if (tsLastFlowSampleMs == 0) {
    tsLastFlowSampleMs = sampleNow;
    lastFlowSampleCount = flowPulseCount;
  } else if (sampleNow - tsLastFlowSampleMs >= 5000) {
    unsigned long deltaCount = flowPulseCount - lastFlowSampleCount;
    unsigned long deltaMs = sampleNow - tsLastFlowSampleMs;
    if (deltaMs > 0) {
      flowRateLpm = ((float)deltaCount * 60000.0f) / (PULSES_PER_LITER * (float)deltaMs);
    } else {
      flowRateLpm = 0.0f;
    }
    lastFlowSampleCount = flowPulseCount;
    tsLastFlowSampleMs = sampleNow;
  }

  bool flowRecent = (lastFlowPulseMs > 0) && (sampleNow - lastFlowPulseMs <= 3000UL);
  status.flowing = status.pumpOn && (flowRecent || flowPulseCount > 0);

  status.reservoirTempC = reservoirTempC;
  status.towerTempC = towerTempC;
  status.flowRateLpm = flowRateLpm;
  status.sensorDataOk = dhtOk || (!isnan(reservoirTempC) && !isnan(towerTempC));
  if (!status.sensorDataOk) {
    status.fault = "OK";
  }
}

// ─────────────────────────────────────────────────────────────────────
//  LIGHT RELAY — auto control via LDR
// ─────────────────────────────────────────────────────────────────────

void manageLightRelay() {
  if (lightManualMode != MANUAL_AUTO) return;

  // Only auto-control if LDR gave a valid reading
  bool ldrValid = (sensors.lightRaw >= LDR_MIN_VALID);
  // [FIX-7] Note: sensors.lightRaw > LDR_MIN_VALID ensures sensor is connected.
  // sensors.isDark == true  → room is dark  → turn light ON
  // sensors.isDark == false → room has light → turn light OFF
  bool shouldBeOn = ldrValid && sensors.isDark;

  if (shouldBeOn != status.lightOn) {
    setRelayState(PIN_LED_RELAY, shouldBeOn);
    status.lightOn = shouldBeOn;
    Serial.printf("[LIGHT] %s (LDR raw=%d)\n",
                  shouldBeOn ? "ON" : "OFF", sensors.lightRaw);
  }
}

// ─────────────────────────────────────────────────────────────────────
//  BATTERY CHARGE RELAY — time-window controlled
// ─────────────────────────────────────────────────────────────────────

void manageBatteryChargeRelay() {
  // Require a valid NTP-synced time before controlling battery charge
  if (!ntpSynced) {
    if (status.batteryChargeOn) {
      setRelayState(PIN_BATTERY_CHARGE_RELAY, false);
      status.batteryChargeOn = false;
    }
    return;
  }

  time_t epochNow = getCurrentEpoch();
  if (epochNow <= 0) return;

  struct tm localTime = {};
  if (!localtime_r(&epochNow, &localTime)) return;  // [FIX-8] thread-safe

  unsigned long secInDay = (unsigned long)localTime.tm_hour * 3600UL
                         + (unsigned long)localTime.tm_min  * 60UL
                         + (unsigned long)localTime.tm_sec;

  unsigned long chargeEnd = batteryChargeStartSec + batteryChargeDurSec;
  bool shouldCharge = (secInDay >= batteryChargeStartSec && secInDay < chargeEnd);

  if (shouldCharge != status.batteryChargeOn) {
    setRelayState(PIN_BATTERY_CHARGE_RELAY, shouldCharge);
    status.batteryChargeOn = shouldCharge;
    Serial.printf("[CHARGE] %s (%02d:%02d window %02lu:00–%02lu:00)\n",
      shouldCharge ? "ON" : "OFF",
      localTime.tm_hour, localTime.tm_min,
      batteryChargeStartSec / 3600UL,
      chargeEnd / 3600UL);
  }
}

// ─────────────────────────────────────────────────────────────────────
//  MANUAL BUTTONS (physical)
// ─────────────────────────────────────────────────────────────────────

void handleButtonEdge(int pin, ButtonState& btn, ManualMode& mode,
                      const char* label, unsigned long now) {
  bool reading = digitalRead(pin);
  if (reading != btn.lastReading) {
    btn.lastChangeMs = now;
    btn.lastReading  = reading;
  }
  if ((now - btn.lastChangeMs) > BUTTON_DEBOUNCE_MS && reading != btn.stableState) {
    btn.stableState = reading;
    if (btn.stableState == LOW) {
      // Cycle: AUTO → FORCED_ON → FORCED_OFF → AUTO
      mode = (mode == MANUAL_AUTO)     ? MANUAL_FORCE_ON  :
             (mode == MANUAL_FORCE_ON) ? MANUAL_FORCE_OFF : MANUAL_AUTO;
      Serial.printf("[BUTTON] %s → %s\n", label, manualModeToString(mode));
    }
  }
}

void handleManualButtons(unsigned long now) {
  handleButtonEdge(PIN_MOTOR_BUTTON, motorButton, motorManualMode, "MOTOR", now);
  handleButtonEdge(PIN_LIGHT_BUTTON, lightButton, lightManualMode, "LIGHT", now);
}

// ─────────────────────────────────────────────────────────────────────
//  SAFETY CHECKS  [FIX-3] — Previously empty
// ─────────────────────────────────────────────────────────────────────

void checkSafety(unsigned long now) {
  if (!sensors.valid) return;

  // Keep the flow truth tied to the active pump cycle.
  bool flowDetected = (status.pumpOn && lastFlowPulseMs > 0 && (now - lastFlowPulseMs <= PUMP_FLOW_VERIFY_MS));
  status.flowing = flowDetected;

  // High temperature alert
  if (sensors.airTempC > TEMP_AIR_MAX_C) {
    Serial.printf("[SAFETY] Air temp %.1f°C exceeds %.1f°C limit\n",
                  sensors.airTempC, TEMP_AIR_MAX_C);
    // Don't stop pump — temperature is room air, not water
    // Just log the alert to backend via status post
    if (status.fault == "OK") {
      status.fault = "TEMP_HIGH";
    }
  } else if (status.fault == "TEMP_HIGH") {
    // Fault auto-clears when condition resolves
    status.fault = "OK";
  }

  // Very high humidity alert (risk of fungal disease on plants)
  if (sensors.humidityPct > HUMIDITY_MAX_PCT) {
    Serial.printf("[SAFETY] Humidity %.1f%% exceeds %.1f%% limit\n",
                  sensors.humidityPct, HUMIDITY_MAX_PCT);
    if (status.fault == "OK") {
      status.fault = "HUMIDITY_HIGH";
    }
  } else if (status.fault == "HUMIDITY_HIGH") {
    status.fault = "OK";
  }

  // Pump hard timeout: if pump running longer than PUMP_MAX_RUN_MS, stop it
  if (status.pumpOn && (now - pumpStartMs >= PUMP_MAX_RUN_MS)) {
    Serial.println("[SAFETY] Pump max runtime exceeded — emergency stop");
    setRelayState(PIN_PUMP_RELAY, false);
    status.pumpOn = false;
    enterFault(now, "PUMP_TIMEOUT");
    return;
  }

  // No-flow protection: if the relay is on but no pulse arrives quickly,
  // stop the pump rather than letting the backend show a false running state.
  if (status.pumpOn && (now - pumpStartMs >= PUMP_FLOW_VERIFY_MS) && !flowDetected) {
    Serial.println("[SAFETY] Pump started but no flow detected — emergency stop");
    setRelayState(PIN_PUMP_RELAY, false);
    status.pumpOn = false;
    enterFault(now, "NO_FLOW");
  }
}

// ─────────────────────────────────────────────────────────────────────
//  STATE MACHINE
// ─────────────────────────────────────────────────────────────────────

void runStateMachine(unsigned long now) {
  // [FIX-2] Handle manual mode FIRST as a complete override.
  // Apply outputs and return — do NOT fall through to other states.
  if (motorManualMode != MANUAL_AUTO || lightManualMode != MANUAL_AUTO) {
    if (curState != STATE_MANUAL_MODE) {
      Serial.println("[SM] → MANUAL_MODE");
      curState = STATE_MANUAL_MODE;
    }
    stateManual(now);
    return;   // ← Early return prevents state machine overriding manual
  }

  // If we just left manual mode, return to IDLE
  if (curState == STATE_MANUAL_MODE) {
    Serial.println("[SM] MANUAL_MODE → IDLE");
    curState = STATE_IDLE;
  }

  if (curState != prevState) {
    Serial.printf("[SM] %s → %s\n",
      STATE_NAMES[prevState], STATE_NAMES[curState]);
    prevState = curState;
  }

  switch (curState) {
    case STATE_IDLE:        stateIdle(now);        break;
    case STATE_CHECK_WATER: stateCheckWater(now);  break;
    case STATE_PUMP_ON:     statePumpOn(now);       break;
    case STATE_RUNNING:     stateRunning(now);      break;
    case STATE_STOPPING:    stateStopping(now);     break;
    case STATE_FAULT:       stateFault(now);        break;
    case STATE_RECOVERY:    stateRecovery(now);     break;
    default: break;
  }
}

void stateIdle(unsigned long now) {
  (void)now;
  if (!schedule.enabled) return;
  if (isTimeToWater()) {
    Serial.println("[SCHED] Time to water — starting cycle");
    curState = STATE_CHECK_WATER;
  }
}

// [FIX-4] stateCheckWater now validates sensor health before allowing pump start
void stateCheckWater(unsigned long now) {
  // If DHT sensor has failed, block pump start and raise fault
  if (!sensors.valid) {
    Serial.println("[CHECK] Sensor invalid — blocking pump start");
    enterFault(now, "SENSOR_FAIL");
    return;
  }
  // All checks passed
  pumpStartMs = now;
  curState    = STATE_PUMP_ON;
}

void statePumpOn(unsigned long now) {
  (void)now;
  Serial.printf("[PUMP] Starting — duration %ds\n", schedule.durationSeconds);
  setRelayState(PIN_PUMP_RELAY, true);
  status.pumpOn          = true;
  status.flowing         = false;
  flowPulseCount         = 0;
  lastFlowPulseMs        = 0;
  lastFlowSampleCount    = 0;
  tsLastFlowSampleMs     = now;
  pumpScheduledEndMs     = pumpStartMs + (unsigned long)(schedule.durationSeconds * 1000UL);
  curState               = STATE_RUNNING;
}

void stateRunning(unsigned long now) {
  if (now >= pumpScheduledEndMs) {
    Serial.println("[PUMP] Scheduled duration complete");
    curState = STATE_STOPPING;
  }
  // Hard timeout guard is in checkSafety() [FIX-3]
}

void stateStopping(unsigned long now) {
  setRelayState(PIN_PUMP_RELAY, false);
  status.pumpOn = false;

  unsigned long durMs = now - pumpStartMs;
  Serial.printf("[PUMP] Stopped — runtime %.1fs\n", durMs / 1000.0f);

  // Update last-run timestamp
  time_t epochNow = getCurrentEpoch();
  if (epochNow > 0) {
    status.lastRunEpoch = epochNow;
    saveLastRunToNVS(epochNow);
  }

  // Log cycle using the actual flow sensor state and pulse-derived volume.
  bool flowed = flowPulseCount > 0 || status.flowing;
  logPumpCycle(durMs / 1000.0f, flowed, status.fault);

  // Clear transient fault if pump stopped cleanly
  if (status.fault == "OK" || status.fault.length() == 0) {
    status.fault = "OK";
  }

  // [FIX-5] Always clear deferred fault flag in stateStopping
  if (deferredFault) {
    String code = deferredFaultCode;
    deferredFault     = false;
    deferredFaultCode = "";
    enterFault(now, code.c_str());
    return;
  }

  curState = STATE_IDLE;
}

void stateFault(unsigned long now) {
  // Ensure pump is off
  if (status.pumpOn) {
    setRelayState(PIN_PUMP_RELAY, false);
    status.pumpOn = false;
    Serial.println("[FAULT] Forced pump OFF");
  }
  if (now - faultStartMs >= FAULT_RETRY_MS) {
    Serial.println("[FAULT] Retry delay passed → RECOVERY");
    curState = STATE_RECOVERY;
  }
}

void stateRecovery(unsigned long now) {
  (void)now;
  Serial.println("[RECOVERY] Conditions cleared → IDLE");
  status.fault      = "OK";
  faultCode         = "OK";
  // [FIX-5] Ensure deferred fault is fully cleared on recovery path too
  deferredFault     = false;
  deferredFaultCode = "";
  curState = STATE_IDLE;
}

// [FIX-2] stateManual applies outputs; caller (runStateMachine) already
// returns early after this — no state override possible
void stateManual(unsigned long now) {
  (void)now;

  // Motor
  if (motorManualMode == MANUAL_FORCE_ON) {
    setRelayState(PIN_PUMP_RELAY, true);
    status.pumpOn = true;
  } else if (motorManualMode == MANUAL_FORCE_OFF) {
    setRelayState(PIN_PUMP_RELAY, false);
    status.pumpOn = false;
  }

  // Light
  if (lightManualMode == MANUAL_FORCE_ON) {
    setRelayState(PIN_LED_RELAY, true);
    status.lightOn = true;
  } else if (lightManualMode == MANUAL_FORCE_OFF) {
    setRelayState(PIN_LED_RELAY, false);
    status.lightOn = false;
  }
}

void enterFault(unsigned long now, const char* code) {
  faultCode     = code;
  status.fault  = String(code);
  faultStartMs  = now;
  lastFaultCode = code;
  saveLastFaultToNVS(code);

  // Defer if pump is currently running — don't abruptly stop mid-cycle
  if (status.pumpOn) {
    deferredFault     = true;
    deferredFaultCode = String(code);
    Serial.printf("[FAULT] Deferred (pump running): %s\n", code);
    return;
  }

  // [FIX-5] Clear deferred state since we're entering fault directly
  deferredFault     = false;
  deferredFaultCode = "";
  curState = STATE_FAULT;
  Serial.printf("[FAULT] → %s\n", code);
}

// ─────────────────────────────────────────────────────────────────────
//  SCHEDULING
// ─────────────────────────────────────────────────────────────────────

bool isTimeToWater() {
  time_t epochNow = getCurrentEpoch();

  if (epochNow == 0) {
    // No time available — first-run fallback
    if (status.lastRunEpoch == 0) return true;
    return false;
  }

  struct tm t = {};
  // [FIX-8] Use thread-safe localtime_r
  if (!localtime_r(&epochNow, &t)) return false;

  if (t.tm_hour < schedule.startHour || t.tm_hour >= schedule.endHour)
    return false;

  time_t secondsSinceLastRun = epochNow - status.lastRunEpoch;
  time_t intervalSeconds     = (time_t)(schedule.intervalMinutes * 60);

  return (secondsSinceLastRun >= intervalSeconds);
}

// ─────────────────────────────────────────────────────────────────────
//  API COMMUNICATION
// ─────────────────────────────────────────────────────────────────────

int httpRequest(const char* method, const char* path,
                const String& body = "") {
  if (!wifiConnected) return -1;
  HTTPClient http;
  http.setTimeout(API_TIMEOUT_MS);
  http.begin(String(API_BASE_URL) + path);
  http.addHeader("Content-Type", "application/json");
  http.addHeader("X-Device-ID",  DEVICE_ID);
  http.addHeader("X-API-Key",    DEVICE_SECRET);
  int code = -1;
  if (strcmp(method, "GET")  == 0) code = http.GET();
  if (strcmp(method, "POST") == 0) code = http.POST(body);
  if (strcmp(method, "PUT")  == 0) code = http.PUT(body);
  http.end();
  return code;
}

// Fetch schedule AND remote manual mode overrides from backend.
// [FIX-10] Combined into one function called every IV_SCHEDULE (60s)
//          instead of syncRemoteManualModes() every 3s.
void fetchScheduleAndSync() {
  if (!wifiConnected) {
    Serial.println("[API] Offline — NVS schedule in use");
    return;
  }

  // ── 1. Fetch schedule ─────────────────────────────────────────────
  {
    HTTPClient http;
    http.setTimeout(API_TIMEOUT_MS);
    http.begin(String(API_BASE_URL) + "/api/schedule");
    http.addHeader("X-Device-ID", DEVICE_ID);
    http.addHeader("X-API-Key",   DEVICE_SECRET);

    int code = http.GET();
    if (code == 200) {
      String resp = http.getString();

      int ni = extractJsonInt(resp, "intervalMinutes");
      int nd = extractJsonInt(resp, "durationSeconds");
      int ns = extractJsonInt(resp, "startHour");
      int ne = extractJsonInt(resp, "endHour");
      // [FIX-11] Battery charge window from backend
      int ncs = extractJsonInt(resp, "chargeStartHour");
      int nce = extractJsonInt(resp, "chargeEndHour");
      bool nen = (resp.indexOf("\"enabled\":true") >= 0);

      // Validate before applying
      if (ni <= 0 || ni > 1440 ||
          nd <= 0 || nd > 600  ||
          ns < 0  || ns > 23   ||
          ne < 0  || ne > 23)  {
        Serial.printf("[API] Rejected invalid schedule (i=%d d=%d s=%d e=%d)\n",
                      ni, nd, ns, ne);
      } else {
        bool changed = (ni != schedule.intervalMinutes ||
                        nd != schedule.durationSeconds ||
                        ns != schedule.startHour       ||
                        ne != schedule.endHour         ||
                        nen != schedule.enabled);

        schedule.intervalMinutes = ni;
        schedule.durationSeconds = nd;
        schedule.startHour       = ns;
        schedule.endHour         = ne;
        schedule.enabled         = nen;

        // [FIX-11] Apply charge window from backend if provided
        if (ncs >= 0 && ncs <= 23 && nce >= 0 && nce <= 23 && nce > ncs) {
          unsigned long newStart = (unsigned long)ncs * 3600UL;
          unsigned long newDur   = (unsigned long)(nce - ncs) * 3600UL;
          if (newStart != batteryChargeStartSec || newDur != batteryChargeDurSec) {
            batteryChargeStartSec = newStart;
            batteryChargeDurSec   = newDur;
            changed = true;
            Serial.printf("[API] Charge window updated: %02d:00–%02d:00\n", ncs, nce);
          }
        }

        // Parse optional planName and scheduleAppliedAt
        String planName = extractJsonString(resp, "planName");
        if (planName.length() > 0 && planName != appliedPlanName) {
          appliedPlanName = planName;
          scheduleAppliedAt = (time_t)extractJsonInt(resp, "scheduleAppliedAt");
        }

        if (changed) {
          scheduleAppliedAt = getCurrentEpoch();
          saveScheduleToNVS();
          savePlanNameToNVS(appliedPlanName);
          if (scheduleAppliedAt > 0 && wifiConnected) {
            String ack = "{";
            ack += "\"scheduleAppliedAt\":" + String((uint32_t)scheduleAppliedAt);
            if (appliedPlanName.length() > 0) {
              ack += ",\"planName\":\"" + appliedPlanName + "\"";
            }
            ack += "}";
            int ackCode = httpRequest("PUT", "/api/status", ack);
            if (ackCode != 200 && ackCode != 204) {
              Serial.printf("[API] Failed to notify backend of applied schedule (HTTP %d)\n", ackCode);
            }
          }
          Serial.printf("[API] Schedule updated: every %dmin for %ds (%02d:00–%02d:00)\n",
                        ni, nd, ns, ne);
        }
      }
    } else {
      Serial.printf("[API] Schedule fetch failed (HTTP %d)\n", code);
    }
    http.end();
  }

  // ── 2. Fetch remote manual mode overrides ─────────────────────────
  // [FIX-10] Was previously syncRemoteManualModes() called every 3s.
  // Now runs at the same 60s cadence — backend changes are picked up
  // within one minute which is acceptable for manual control.
  {
    HTTPClient http;
    http.setTimeout(API_TIMEOUT_MS);
    http.begin(String(API_BASE_URL) + "/api/status");
    http.addHeader("X-Device-ID", DEVICE_ID);
    http.addHeader("X-API-Key",   DEVICE_SECRET);

    int code = http.GET();
    if (code == 200) {
      String resp = http.getString();

      String pm = extractJsonString(resp, "motorManualMode");
      String lm = extractJsonString(resp, "lightManualMode");
      // Parse retry hint from server (in seconds)
      int retryIn = extractJsonInt(resp, "retryNextCycleIn");

      if (pm.length() > 0) {
        ManualMode newMotor = manualModeFromString(pm);
        if (newMotor != motorManualMode) {
          motorManualMode = newMotor;
          Serial.printf("[API] Remote motor mode: %s\n", manualModeToString(motorManualMode));
        }
      }
      if (lm.length() > 0) {
        ManualMode newLight = manualModeFromString(lm);
        if (newLight != lightManualMode) {
          lightManualMode = newLight;
          Serial.printf("[API] Remote light mode: %s\n", manualModeToString(lightManualMode));
        }
      }
      // If a retry is requested within the next couple seconds, trigger immediate cycle
      if (retryIn >= 0 && retryIn <= 2) {
        Serial.printf("[API] Retry requested in %ds\n", retryIn);
        if (curState == STATE_IDLE && motorManualMode == MANUAL_AUTO && schedule.enabled) {
          Serial.println("[API] Triggering immediate retry cycle");
          pumpStartMs = millis();
          curState = STATE_CHECK_WATER; // state machine will validate and start pump
        }
      }
    }
    http.end();
  }
}

void postStatus() {
  if (!wifiConnected) return;

  String reportedState = (status.pumpOn && !status.flowing)
    ? String("VERIFYING_FLOW")
    : String(STATE_NAMES[curState]);

  String body = "{";
  body += "\"pumpOn\":"           + String(status.pumpOn        ? "true" : "false") + ",";
  body += "\"flowing\":"          + String(status.flowing       ? "true" : "false") + ",";
  body += "\"lightOn\":"          + String(status.lightOn       ? "true" : "false") + ",";
  body += "\"batteryChargeOn\":"  + String(status.batteryChargeOn ? "true" : "false") + ",";
  body += "\"humidityPct\":"      + String(status.humidityPct, 1) + ",";
  body += "\"airTempC\":"         + String(status.airTempC, 1) + ",";  // [FIX-9]
  body += "\"lightRaw\":"         + String(status.lightRaw) + ",";     // [FIX-7] correct name
  body += "\"lightDark\":"        + String(status.lightDark ? "true" : "false") + ","; // [FIX-7]
  body += "\"dhtOk\":"            + String(status.dhtOk ? "true" : "false") + ",";
  body += "\"fault\":\""          + status.fault + "\",";
  body += "\"state\":\""          + reportedState + "\",";
  body += "\"motorManualMode\":\"" + String(manualModeToString(motorManualMode)) + "\",";
  body += "\"lightManualMode\":\"" + String(manualModeToString(lightManualMode)) + "\",";
  body += "\"resetReason\":\""    + bootResetReason + "\",";
  body += "\"lastBootFault\":\""  + bootLastFault + "\",";
  body += "\"uptimeSec\":"        + String((uint32_t)(millis() / 1000UL)) + ",";
  body += "\"pendingLogs\":"      + String(getOfflineLogCount()) + ",";
  body += "\"wifiConnected\":"    + String(wifiConnected ? "true" : "false");
  // Optional fields
  if (appliedPlanName.length() > 0) {
    body += ",\"appliedPlanName\":\"" + appliedPlanName + "\"";
  }
  if (scheduleAppliedAt > 0) {
    body += ",\"scheduleAppliedAt\":" + String((uint32_t)scheduleAppliedAt);
  }
  body += ",\"reservoirTempC\":" + String(status.reservoirTempC, 1);
  body += ",\"towerTempC\":" + String(status.towerTempC, 1);
  body += ",\"flowRateLpm\":" + String(status.flowRateLpm, 2);
  body += ",\"sensorDataOk\":" + String(status.sensorDataOk ? "true" : "false");
  body += "}";

  int code = httpRequest("PUT", "/api/status", body);
  if (code != 200 && code != 204) {
    Serial.printf("[API] Status POST failed (HTTP %d)\n", code);
  }
}

void logPumpCycle(float durationSec, bool flowed, String fault) {
  LogEntry entry;
  entry.timestamp       = getCurrentEpoch();
  entry.durationSeconds = (uint16_t)durationSec;
  entry.flowed          = flowed;
  fault.toCharArray(entry.fault, sizeof(entry.fault));

  if (!wifiConnected || !postLogEntryToAPI(entry)) {
    pushOfflineLog(entry);
  }
}

bool postLogEntryToAPI(const LogEntry& entry) {
  String body = "{";
  body += "\"timestamp\":"       + String((uint32_t)entry.timestamp) + ",";
  body += "\"durationSeconds\":" + String(entry.durationSeconds) + ",";
  body += "\"flowed\":"          + String(entry.flowed ? "true" : "false") + ",";
  body += "\"fault\":\""         + String(entry.fault) + "\"";
  body += "}";

  int code = httpRequest("POST", "/api/pump-log", body);
  if (code == 200 || code == 201) return true;
  Serial.printf("[API] Log POST failed (HTTP %d)\n", code);
  return false;
}

// ─────────────────────────────────────────────────────────────────────
//  SETUP
// ─────────────────────────────────────────────────────────────────────

void setup() {
  Serial.begin(115200);
  unsigned long t0 = millis();
  while (millis() - t0 < 300) yield();

  Serial.println(F("\n╔══════════════════════════════════════╗"));
  Serial.println(F("║  TOWER GARDEN v3.0 — Fixed & Hardened ║"));
  Serial.println(F("╚══════════════════════════════════════╝\n"));

  // ── Boot diagnostics ──────────────────────────────────────────────
  loadLastFaultFromNVS();
  esp_reset_reason_t resetReason = esp_reset_reason();
  bootResetReason = String(resetReasonToString(resetReason));
  bootLastFault   = lastFaultCode;
  Serial.printf("[BOOT] Reset: %s | Last fault: %s\n",
                bootResetReason.c_str(), bootLastFault.c_str());

  // ── GPIO setup ────────────────────────────────────────────────────
  pinMode(PIN_PUMP_RELAY,            OUTPUT);
  pinMode(PIN_LED_RELAY,             OUTPUT);
  pinMode(PIN_BATTERY_CHARGE_RELAY,  OUTPUT);
  pinMode(PIN_SPARE_RELAY,           OUTPUT);
  setRelayState(PIN_PUMP_RELAY,           false);
  setRelayState(PIN_LED_RELAY,            false);
  setRelayState(PIN_BATTERY_CHARGE_RELAY, false);
  setRelayState(PIN_SPARE_RELAY,          false);

  pinMode(PIN_DHT_DATA,     INPUT_PULLUP);
  pinMode(PIN_LDR_SENSOR,   INPUT);
  pinMode(PIN_MOTOR_BUTTON, INPUT_PULLUP);
  pinMode(PIN_LIGHT_BUTTON, INPUT_PULLUP);

  // ── Sensors ───────────────────────────────────────────────────────
  dht.begin();
  // DS18B20 sensors
  resTempSensor.begin();
  towerTempSensor.begin();

  // Flow sensor wiring
  pinMode(PIN_FLOW_SENSOR, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(PIN_FLOW_SENSOR), flowPulseISR, RISING);

  // ── [FIX-6] Watchdog init ─────────────────────────────────────────
  esp_task_wdt_config_t wdtCfg = {
    .timeout_ms     = 45000,   // 45-second timeout
    .idle_core_mask = 0,
    .trigger_panic  = true
  };
  esp_task_wdt_reconfigure(&wdtCfg);
  esp_task_wdt_add(NULL);     // Add current task to watchdog
  Serial.println("[WDT] Watchdog enabled (45s timeout)");

  // ── NVS load ──────────────────────────────────────────────────────
  loadScheduleFromNVS();
  loadPlanNameFromNVS();

  // ── WiFi (async — completes in loop) ──────────────────────────────
  initWiFi();

  // ── Initial sensor read ───────────────────────────────────────────
  readSensors();

  // ── Timestamp init ────────────────────────────────────────────────
  unsigned long now    = millis();
  tsLastSensor         = now;
  tsLastScheduleFetch  = now;
  tsLastStatusPost     = now;
  tsLastWifiCheck      = 0;   // Force immediate WiFi check
  tsLastWdtFeed        = now;
  tsLastLogFlush       = now;

  curState  = STATE_IDLE;
  prevState = STATE_IDLE;

  Serial.println("[BOOT] System ready\n");
}

// ─────────────────────────────────────────────────────────────────────
//  MAIN LOOP — 100% non-blocking
// ─────────────────────────────────────────────────────────────────────

void loop() {
  unsigned long now = millis();

  // ── 1. Watchdog feed [FIX-6] ──────────────────────────────────────
  if (now - tsLastWdtFeed >= IV_WDT_FEED) {
    esp_task_wdt_reset();
    tsLastWdtFeed = now;
  }

  // ── 2. WiFi maintenance ───────────────────────────────────────────
  maintainWiFi(now);

  // ── 3. NTP validation (runs until confirmed) ──────────────────────
  if (!ntpSynced && wifiConnected) {
    checkNTPSync();
  }

  // ── 4. Sensor readings ────────────────────────────────────────────
  if (now - tsLastSensor >= IV_SENSOR) {
    readSensors();
    tsLastSensor = now;
  }

  // ── 5. Physical button handling ───────────────────────────────────
  handleManualButtons(now);

  // ── 6. Safety checks ──────────────────────────────────────────────
  checkSafety(now);

  // ── 7. Schedule + remote manual mode sync (every 60s) [FIX-10] ───
  if (now - tsLastScheduleFetch >= IV_SCHEDULE) {
    fetchScheduleAndSync();
    tsLastScheduleFetch = now;
  }

  // ── 8. Peripheral relay auto-control ─────────────────────────────
  manageLightRelay();
  manageBatteryChargeRelay();

  // ── 9. State machine (pump schedule execution) ────────────────────
  runStateMachine(now);

  // ── 10. Status post to backend ────────────────────────────────────
  unsigned long statusPostInterval = status.pumpOn ? 3000UL : IV_STATUS_POST;
  if (now - tsLastStatusPost >= statusPostInterval) {
    postStatus();
    tsLastStatusPost = now;
  }

  // ── 11. Offline log queue flush ───────────────────────────────────
  if (now - tsLastLogFlush >= IV_LOG_FLUSH) {
    flushOfflineLogQueue();
    tsLastLogFlush = now;
  }

  yield();
}

