  schedule.nightIntervalMinutes = prefs.getInt(NVS_SCHED_NIGHT_INT, schedule.intervalMinutes);
  schedule.nightDurationSeconds = prefs.getInt(NVS_SCHED_NIGHT_DUR, schedule.durationSeconds);
  schedule.nutritionEnabled = prefs.getBool(NVS_NUTRI_EN, true);
  schedule.targetPh        = prefs.getFloat(NVS_TARGET_PH, 6.0f);
  schedule.targetEc        = prefs.getFloat(NVS_TARGET_EC, 1.2f);
  schedule.phDoseSeconds   = prefs.getInt(NVS_PH_DOSE_SEC, 5);
  schedule.phDoseIntervalMinutes = prefs.getInt(NVS_PH_COOLDOWN, 30);
  schedule.ecDoseSeconds   = prefs.getInt(NVS_EC_DOSE_SEC, 10);
  schedule.ecDoseIntervalMinutes = prefs.getInt(NVS_EC_COOLDOWN, 30);
  lastAutoRunEpoch         = (time_t)prefs.getUInt(NVS_LAST_RUN, 0);
  status.lastRunEpoch      = lastAutoRunEpoch;
  ntpSynced                = prefs.getBool(NVS_TIME_VALID, false);
  prefs.end();

  if (clampScheduleValues()) {
    saveScheduleToNVS();
  }
  Serial.printf("[NVS] Schedule loaded: every %dmin for %ds (%02d:00–%02d:00)\n",
    schedule.intervalMinutes, schedule.durationSeconds,
    schedule.startHour, schedule.endHour);
}

bool shouldLightBeOnBySchedule(time_t epochNow) {
  if (!schedule.lightEnabled || !schedule.enabled) {
    return false;
  }

  struct tm localTime = {};
  if (!localtime_r(&epochNow, &localTime)) {
    return false;
  }

  const bool inWindow = localTime.tm_hour >= schedule.lightStartHour && localTime.tm_hour < schedule.lightEndHour;
  return inWindow;
}

void getActivePumpProfile(time_t epochNow, int& intervalMinutes, int& durationSeconds) {
  struct tm localTime = {};
  if (epochNow > 0 && localtime_r(&epochNow, &localTime)) {
    bool isDay = localTime.tm_hour >= schedule.startHour && localTime.tm_hour < schedule.endHour;
    if (isDay || !schedule.nightEnabled) {
      intervalMinutes = schedule.dayIntervalMinutes;
      durationSeconds = schedule.dayDurationSeconds;
      return;
    }
    intervalMinutes = schedule.nightIntervalMinutes;
    durationSeconds = schedule.nightDurationSeconds;
    return;
  }

  intervalMinutes = schedule.intervalMinutes;
  durationSeconds = schedule.durationSeconds;
}

