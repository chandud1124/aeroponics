// ─────────────────────────────────────────────────────────────────────
//  OFFLINE LOG QUEUE
// ─────────────────────────────────────────────────────────────────────

int getOfflineLogCount() {
  prefs.begin(NVS_NS, true);
  int n = prefs.getInt(NVS_LOG_COUNT, 0);
  prefs.end();
  return min(n, OFFLINE_LOG_MAX);
}

void pushOfflineLog(LogEntry& entry) {
  prefs.begin(NVS_NS, false);
  int n = prefs.getInt(NVS_LOG_COUNT, 0);
  if (n >= OFFLINE_LOG_MAX) {
    // Shift queue — discard oldest entry
    for (int i = 0; i < n - 1; i++) {
      char kFrom[12], kTo[12];
      snprintf(kFrom, sizeof(kFrom), "log%d", i + 1);
      snprintf(kTo,   sizeof(kTo),   "log%d", i);
      LogEntry tmp;
      if (prefs.getBytes(kFrom, &tmp, sizeof(LogEntry)) == sizeof(LogEntry))
        prefs.putBytes(kTo, &tmp, sizeof(LogEntry));
    }
    n--;
  }
  char key[12];
  snprintf(key, sizeof(key), "log%d", n);
  size_t written = prefs.putBytes(key, &entry, sizeof(LogEntry));
  if (written == sizeof(LogEntry)) prefs.putInt(NVS_LOG_COUNT, n + 1);
  else Serial.println("[LOG] ✗ NVS write failed for log entry");
  prefs.end();
}

void flushOfflineLogQueue() {
  if (!wifiConnected) return;
  int n = getOfflineLogCount();
  if (n == 0) return;

  Serial.printf("[LOG] Flushing %d offline entries...\n", n);
  int sent = 0;
  for (int i = 0; i < n; i++) {
    char key[12];
    snprintf(key, sizeof(key), "log%d", i);
    prefs.begin(NVS_NS, true);
    LogEntry entry;
    size_t len = prefs.getBytes(key, &entry, sizeof(LogEntry));
    prefs.end();
    if (len != sizeof(LogEntry)) continue;
    if (postLogEntryToAPI(entry)) sent++;
    else break; // Stop if backend is unreachable
  }

  if (sent > 0) {
    prefs.begin(NVS_NS, false);
    int remaining = n - sent;
    for (int i = 0; i < remaining; i++) {
      char kFrom[12], kTo[12];
      snprintf(kFrom, sizeof(kFrom), "log%d", i + sent);
      snprintf(kTo,   sizeof(kTo),   "log%d", i);
      LogEntry tmp;
      if (prefs.getBytes(kFrom, &tmp, sizeof(LogEntry)) == sizeof(LogEntry))
        prefs.putBytes(kTo, &tmp, sizeof(LogEntry));
    }
    prefs.putInt(NVS_LOG_COUNT, remaining);
    prefs.end();
    Serial.printf("[LOG] Flushed %d / %d entries.\n", sent, n);
  }
}

// ─────────────────────────────────────────────────────────────────────
//  WiFi — NON-BLOCKING WITH EXPONENTIAL BACKOFF
// ─────────────────────────────────────────────────────────────────────

void initWiFi() {
  WiFi.mode(WIFI_STA);
  WiFi.persistent(false);
  WiFi.setSleep(false);
  WiFi.setAutoReconnect(false);
  WiFi.setTxPower(WIFI_POWER_11dBm);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  tsLastWifiAttempt = millis();
  Serial.printf("[WiFi] Connecting to '%s'...\n", WIFI_SSID);
}

void maintainWiFi(unsigned long now) {
  if (now - tsLastWifiCheck < IV_WIFI_CHECK) return;
  tsLastWifiCheck = now;

  bool connected = (WiFi.status() == WL_CONNECTED);

  if (connected && !wifiConnected) {
    wifiConnected = true;
    wifiBackoffMs = 5000UL;  // Reset backoff on success
    Serial.print("[WiFi] Connected: ");
    Serial.println(WiFi.localIP());
    // Sync time as soon as we have network
    syncTimeNTP();
    // Immediate status post + sensor read on reconnect
    readSensors();
    postStatus();
    tsLastStatusPost = now;
  } else if (!connected && wifiConnected) {
    wifiConnected = false;
    Serial.println("[WiFi] Disconnected — offline mode");
  }

  if (!connected && (now - tsLastWifiAttempt >= wifiBackoffMs)) {
    Serial.printf("[WiFi] Reconnecting (backoff %lus)...\n", wifiBackoffMs / 1000);
    WiFi.disconnect(false, false);
    WiFi.begin(WIFI_SSID, WIFI_PASS);
    tsLastWifiAttempt = now;
    wifiBackoffMs = min(wifiBackoffMs * 2, WIFI_BACKOFF_MAX);
  }
}

