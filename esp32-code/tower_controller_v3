int httpRequest(const char* method, const char* path,
                const String& body = "") {
  if (!wifiConnected) return -1;
  HTTPClient http;
  http.setTimeout(API_TIMEOUT_MS);
  Serial.printf("[API] %s %s\n", method, path);
  http.begin(String(API_BASE_URL) + path);
  http.addHeader("Content-Type", "application/json");
  String finalDeviceID = (deviceMacAddress.length() > 0) ? deviceMacAddress : String(DEVICE_ID);
  http.addHeader("X-Device-ID",  finalDeviceID);
  http.addHeader("X-API-Key",    DEVICE_SECRET);
  http.addHeader("Connection",   "close");
  int code = -1;
  if (strcmp(method, "GET")  == 0) code = http.GET();
  if (strcmp(method, "POST") == 0) code = http.POST(body);
  if (strcmp(method, "PUT")  == 0) code = http.PUT(body);
  http.end();
  Serial.printf("[API] %s %s -> HTTP %d\n", method, path, code);
  return code;
}

bool fetchHandshakeAndSync() {
  if (!wifiConnected) {
    Serial.println("[API] Offline — NVS schedule in use");
    return false;
  }

  HTTPClient http;
  http.setTimeout(API_TIMEOUT_MS);
  Serial.printf("[API] GET /api/device/handshake\n");
  http.begin(String(API_BASE_URL) + "/api/device/handshake");
  String finalDeviceID = (deviceMacAddress.length() > 0) ? deviceMacAddress : String(DEVICE_ID);
  http.addHeader("X-Device-ID", finalDeviceID);
  http.addHeader("X-API-Key",   DEVICE_SECRET);
  http.addHeader("Connection",  "close");

  int code = http.GET();
  if (code != 200) {
    Serial.printf("[API] Handshake failed (HTTP %d)\n", code);
    http.end();
    return false;
  }

  String resp = http.getString();
  Serial.printf("[API] Handshake OK (%u bytes)\n", (unsigned)resp.length());
  http.end();

  // Extract and sync serverTime to ESP32 system clock
  String stStr = extractJsonNumber(resp, "serverTime");
  if (stStr.length() > 0) {
    long long serverTimeMs = atoll(stStr.c_str());
    time_t serverTimeSec = (time_t)(serverTimeMs / 1000LL);
    if (serverTimeSec > 1700000000UL) {
      struct timeval tv;
      tv.tv_sec = serverTimeSec;
      tv.tv_usec = 0;
      settimeofday(&tv, NULL);
      if (!ntpSynced) {
        ntpSynced = true;
        saveNTPValidToNVS(true);
        Serial.printf("[Time] Synced system clock from serverTime: %lu\n", (unsigned long)serverTimeSec);
      }
    }
  }

  int ni = extractJsonInt(resp, "intervalMinutes");
  int nd = extractJsonInt(resp, "durationSeconds");
  int ns = extractJsonInt(resp, "startHour");
  int ne = extractJsonInt(resp, "endHour");
  int dDayInt = extractJsonInt(resp, "dayIntervalMinutes");
  int dDayDur = extractJsonInt(resp, "dayDurationSeconds");
  int dNightInt = extractJsonInt(resp, "nightIntervalMinutes");
  int dNightDur = extractJsonInt(resp, "nightDurationSeconds");
  int levelRx = extractJsonInt(resp, "pin_level_sensor_rx");
  int levelTx = extractJsonInt(resp, "pin_level_sensor_tx");
  float serverEmptyDistance = extractJsonNumber(resp, "emptyDistanceCm").toFloat();
  float serverFullDistance = extractJsonNumber(resp, "fullDistanceCm").toFloat();
  float serverTankWidth = extractJsonNumber(resp, "tankWidthCm").toFloat();
  float serverTankLength = extractJsonNumber(resp, "tankLengthCm").toFloat();
  float serverTankHeight = extractJsonNumber(resp, "tankHeightCm").toFloat();
  float serverTankCapacity = extractJsonNumber(resp, "tankCapacityLiters").toFloat();
  bool hasLightEnabled = (findJsonKey(resp, "lightEnabled") >= 0);
  bool lightEnabled = extractJsonBool(resp, "lightEnabled", true);
  int lightStartHour = extractJsonInt(resp, "lightStartHour");
  int lightEndHour = extractJsonInt(resp, "lightEndHour");
  bool hasNightEnabled = (findJsonKey(resp, "nightEnabled") >= 0);
  bool nightEnabled = extractJsonBool(resp, "nightEnabled", true);
  bool hasNutriEnabled = (findJsonKey(resp, "nutritionEnabled") >= 0);
  bool nutriEnabled = extractJsonBool(resp, "nutritionEnabled", true);
  String targetPhStr = extractJsonNumber(resp, "targetPh");
  String targetEcStr = extractJsonNumber(resp, "targetEc");
  int phDoseSec = extractJsonInt(resp, "phDoseSeconds");
  int phDoseCool = extractJsonInt(resp, "phDoseIntervalMinutes");
  int ecDoseSec = extractJsonInt(resp, "ecDoseSeconds");
  int ecDoseCool = extractJsonInt(resp, "ecDoseIntervalMinutes");
  bool nen = extractJsonBool(resp, "enabled", true);

    if (ni > 0 && ni <= 1440 &&
        nd > 0 && nd <= 600  &&
        ns >= 0 && ns <= 23  &&
        ne >= 0 && ne <= 24) {
      bool changed = (ni != schedule.intervalMinutes ||
                      nd != schedule.durationSeconds ||
                      ns != schedule.startHour       ||
                      ne != schedule.endHour         ||
                      nen != schedule.enabled        ||
                      (hasLightEnabled && lightEnabled != schedule.lightEnabled) ||
                      (lightStartHour >= 0 && lightStartHour != schedule.lightStartHour) ||
                      (lightEndHour >= 0 && lightEndHour != schedule.lightEndHour) ||
                      (hasNightEnabled && nightEnabled != schedule.nightEnabled) ||
                      (hasNutriEnabled && nutriEnabled != schedule.nutritionEnabled) ||
                      (targetPhStr.length() > 0 && atof(targetPhStr.c_str()) != schedule.targetPh) ||
                      (targetEcStr.length() > 0 && atof(targetEcStr.c_str()) != schedule.targetEc) ||
                      (phDoseSec > 0 && phDoseSec != schedule.phDoseSeconds) ||
                      (phDoseCool > 0 && phDoseCool != schedule.phDoseIntervalMinutes) ||
                      (ecDoseSec > 0 && ecDoseSec != schedule.ecDoseSeconds) ||
                      (ecDoseCool > 0 && ecDoseCool != schedule.ecDoseIntervalMinutes));

      schedule.intervalMinutes = ni;
      schedule.durationSeconds = nd;
      schedule.startHour = ns;
      schedule.endHour = ne;
      schedule.enabled = nen;
      if (hasLightEnabled) schedule.lightEnabled = lightEnabled;
      if (lightStartHour >= 0 && lightStartHour <= 23) schedule.lightStartHour = lightStartHour;
      if (lightEndHour >= 0 && lightEndHour <= 24) schedule.lightEndHour = lightEndHour;
      if (hasNightEnabled) schedule.nightEnabled = nightEnabled;

      if (dDayInt > 0 && dDayInt <= 1440) schedule.dayIntervalMinutes = dDayInt;
      if (dDayDur > 0 && dDayDur <= 600) schedule.dayDurationSeconds = dDayDur;
      if (dNightInt > 0 && dNightInt <= 1440) schedule.nightIntervalMinutes = dNightInt;
      if (dNightDur > 0 && dNightDur <= 600) schedule.nightDurationSeconds = dNightDur;

      if (hasNutriEnabled) schedule.nutritionEnabled = nutriEnabled;
      if (targetPhStr.length() > 0) schedule.targetPh = atof(targetPhStr.c_str());
      if (targetEcStr.length() > 0) schedule.targetEc = atof(targetEcStr.c_str());
      if (phDoseSec > 0) schedule.phDoseSeconds = phDoseSec;
      if (phDoseCool > 0) schedule.phDoseIntervalMinutes = phDoseCool;
      if (ecDoseSec > 0) schedule.ecDoseSeconds = ecDoseSec;
      if (ecDoseCool > 0) schedule.ecDoseIntervalMinutes = ecDoseCool;

      bool calibrationChanged =
        (levelRx > 0 && levelRx != PIN_LEVEL_SENSOR) ||
        (levelTx > 0 && levelTx != PIN_LEVEL_SENSOR_TX) ||
        (serverEmptyDistance > serverFullDistance && serverEmptyDistance != emptyDistanceCm) ||
        (serverEmptyDistance > serverFullDistance && serverFullDistance != fullDistanceCm) ||
        (serverTankWidth > 0 && serverTankWidth != tankWidthCm) ||
        (serverTankLength > 0 && serverTankLength != tankLengthCm) ||
        (serverTankHeight > 0 && serverTankHeight != tankHeightCm) ||
        (serverTankCapacity > 0 && serverTankCapacity != tankCapacityLiters);
      if (levelRx > 0) PIN_LEVEL_SENSOR = levelRx;
      if (levelTx > 0) PIN_LEVEL_SENSOR_TX = levelTx;
      if (serverEmptyDistance > serverFullDistance) {
        emptyDistanceCm = serverEmptyDistance;
        fullDistanceCm = serverFullDistance;
      }
      if (serverTankWidth > 0) tankWidthCm = serverTankWidth;
      if (serverTankLength > 0) tankLengthCm = serverTankLength;
      if (serverTankHeight > 0) tankHeightCm = serverTankHeight;
      if (serverTankCapacity > 0) tankCapacityLiters = serverTankCapacity;

      String planName = extractJsonString(resp, "planName");
      if (planName.length() > 0 && planName != appliedPlanName) {
        appliedPlanName = planName;
        changed = true;
      }

      if (changed) {
        scheduleAppliedAt = getCurrentEpoch();
        saveScheduleToNVS();
        savePlanNameToNVS(appliedPlanName);

        String ack = "{";
        ack += "\"scheduleAppliedAt\":" + String((uint32_t)scheduleAppliedAt);
        if (appliedPlanName.length() > 0) {
          ack += ",\"planName\":\"" + appliedPlanName + "\"";
        }
        ack += "}";
        int ackCode = httpRequest("PUT", "/api/status", ack);
        if (ackCode != 200 && ackCode != 204) {
          Serial.printf("[API] Failed to notify backend of applied schedule (HTTP %d)\n", ackCode);
        }
      }
      if (calibrationChanged) {
        saveTankCalibrationToNVS();
        setupPinModes();
      }
    } else {
      Serial.printf("[API] Rejected invalid handshake schedule (i=%d d=%d s=%d e=%d)\n", ni, nd, ns, ne);
    }

    String pm = extractJsonString(resp, "motorManualMode");
    String phm = extractJsonString(resp, "phManualMode");
    String nm = extractJsonString(resp, "nutritionManualMode");
    int retryIn = extractJsonInt(resp, "retryNextCycleIn");

    if (pm.length() > 0) {
      ManualMode newMotor = manualModeFromString(pm);
      if (newMotor != motorManualMode) {
        motorManualMode = newMotor;
        Serial.printf("[API] Remote motor mode: %s\n", manualModeToString(motorManualMode));
      }
    }
    if (phm.length() > 0) {
      ManualMode newPh = manualModeFromString(phm);
      if (newPh != phManualMode) {
        phManualMode = newPh;
        Serial.printf("[API] Remote pH mode: %s\n", manualModeToString(phManualMode));
      }
    }
    if (nm.length() > 0) {
      ManualMode newNutri = manualModeFromString(nm);
      if (newNutri != nutritionManualMode) {
        nutritionManualMode = newNutri;
        Serial.printf("[API] Remote nutrition mode: %s\n", manualModeToString(nutritionManualMode));
      }
    }

    int p_pump  = extractJsonInt(resp, "pin_pump_relay");
    int p_nutA  = extractJsonInt(resp, "pin_nutrition_a");
    int p_nutB  = extractJsonInt(resp, "pin_nutrition_b");
    int p_phD   = extractJsonInt(resp, "pin_ph_down");
    int p_phS   = extractJsonInt(resp, "pin_ph_sensor");
    int p_ecS   = extractJsonInt(resp, "pin_ec_sensor");
    int p_level = extractJsonInt(resp, "pin_level_sensor_rx");
    int p_dht   = extractJsonInt(resp, "pin_dht_data");

    bool pinChanged = false;
    if (p_pump > 0 && p_pump != PIN_PUMP_RELAY) { PIN_PUMP_RELAY = p_pump; pinChanged = true; }
    if (p_nutA > 0 && p_nutA != PIN_NUTRITION_A_RELAY) { PIN_NUTRITION_A_RELAY = p_nutA; pinChanged = true; }
    if (p_nutB > 0 && p_nutB != PIN_NUTRITION_B_RELAY) { PIN_NUTRITION_B_RELAY = p_nutB; pinChanged = true; }
    if (p_phD > 0 && p_phD != PIN_PH_DOWN_RELAY) { PIN_PH_DOWN_RELAY = p_phD; pinChanged = true; }
    if (p_phS > 0 && p_phS != PIN_PH_SENSOR) { PIN_PH_SENSOR = p_phS; pinChanged = true; }
    if (p_ecS > 0 && p_ecS != PIN_EC_SENSOR) { PIN_EC_SENSOR = p_ecS; pinChanged = true; }
    if (p_level > 0 && p_level != PIN_LEVEL_SENSOR) { PIN_LEVEL_SENSOR = p_level; pinChanged = true; }
    if (p_dht > 0 && p_dht != PIN_DHT_DATA) { PIN_DHT_DATA = p_dht; pinChanged = true; }

    if (pinChanged) {
      Serial.println("[GPIO] Re-configuring ESP32 pin modes from backend mappings...");
      setupPinModes();
      dht = DHT(PIN_DHT_DATA, DHT22);
      dht.begin();
    }

  if (retryIn >= 0 && retryIn <= 2) {
    Serial.printf("[API] Retry requested in %ds\n", retryIn);
    if (curState == STATE_IDLE && motorManualMode == MANUAL_AUTO && schedule.enabled) {
      Serial.println("[API] Triggering immediate retry cycle");
      pumpStartMs = millis();
      curState = STATE_CHECK_WATER;
    }
  }

  return true;
}

// Fetch authenticated schedule + remote manual mode state from backend.
// [FIX-10] Handshake runs every IV_SCHEDULE (60s), and once immediately after boot.
void fetchScheduleAndSync() {
  if (!fetchHandshakeAndSync()) {
    return;
  }
}

void postStatus() {
  if (!wifiConnected) return;

  const unsigned long STATUS_HEARTBEAT_MS = 60000UL;

  String signature = "";
  signature += String(status.pumpOn ? "1" : "0");
  signature += "|" + String(status.flowing ? "1" : "0");
  signature += "|" + String(status.phDosingOn ? "1" : "0");
  signature += "|" + String(status.nutritionADosingOn ? "1" : "0");
  signature += "|" + String(status.nutritionBDosingOn ? "1" : "0");
  signature += "|" + String(status.dhtOk ? "1" : "0");
  signature += "|" + String(status.sensorDataOk ? "1" : "0");
  signature += "|" + String(status.humidityPct, 1);
  signature += "|" + String(status.phValue, 2);
  signature += "|" + String(status.ecValue, 2);
  signature += "|" + status.fault;
  signature += "|" + String(status.lastRunEpoch);
  signature += "|" + String(manualModeToString(motorManualMode));
  signature += "|" + String(manualModeToString(phManualMode));
  signature += "|" + String(manualModeToString(nutritionManualMode));
  signature += "|" + appliedPlanName;
  signature += "|" + String((uint32_t)scheduleAppliedAt);

  if (signature == lastPostedStatusSignature && (millis() - lastStatusPostMs) < STATUS_HEARTBEAT_MS) {
    return;
  }

  String reportedState = String(STATE_NAMES[curState]);

  String body = "{";
  body += "\"pumpOn\":"           + String(status.pumpOn        ? "true" : "false") + ",";
  body += "\"flowing\":"          + String(status.flowing       ? "true" : "false") + ",";
  body += "\"phDosingOn\":"       + String(status.phDosingOn    ? "true" : "false") + ",";
  body += "\"nutritionADosingOn\":" + String(status.nutritionADosingOn ? "true" : "false") + ",";
  body += "\"nutritionBDosingOn\":" + String(status.nutritionBDosingOn ? "true" : "false") + ",";
  body += "\"humidityPct\":"      + String(status.humidityPct, 1) + ",";
  body += "\"ph\":"               + String(status.phValue, 2) + ",";
  body += "\"ec\":"               + String(status.ecValue, 2) + ",";
  body += "\"waterLevel\":\""     + status.waterLevel + "\",";
  body += "\"waterDistanceCm\":"   + String(status.waterDistanceCm, 1) + ",";
  body += "\"waterLevelPercent\":" + String(status.waterLevelPercent, 1) + ",";
  body += "\"waterVolumeLiters\":" + String(status.waterVolumeLiters, 1) + ",";
  body += "\"reservoirTempC\":"   + String(status.waterTempC, 1) + ",";
  body += "\"dhtOk\":"            + String(status.dhtOk ? "true" : "false") + ",";
  body += "\"humiditySensorOk\":"  + String(sensors.humidityValid ? "true" : "false") + ",";
  body += "\"phSensorOk\":"       + String(sensors.phValid ? "true" : "false") + ",";
  body += "\"ecSensorOk\":"       + String(sensors.ecValid ? "true" : "false") + ",";
  body += "\"levelSensorOk\":"    + String(sensors.levelValid ? "true" : "false") + ",";
  body += "\"fault\":\""          + status.fault + "\",";
  body += "\"state\":\""          + reportedState + "\",";
  body += "\"motorManualMode\":\"" + String(manualModeToString(motorManualMode)) + "\",";
  body += "\"phManualMode\":\""   + String(manualModeToString(phManualMode)) + "\",";
  body += "\"nutritionManualMode\":\"" + String(manualModeToString(nutritionManualMode)) + "\",";
  body += "\"resetReason\":\""    + bootResetReason + "\",";
  body += "\"lastBootFault\":\""  + bootLastFault + "\",";
  body += "\"uptimeSec\":"        + String((uint32_t)(millis() / 1000UL)) + ",";
  body += "\"pendingLogs\":"      + String(getOfflineLogCount()) + ",";
  // Send last pump run epoch so backend can timestamp cycles correctly
  if (status.lastRunEpoch > 0) {
    body += "\"lastRunAt\":"      + String((uint32_t)status.lastRunEpoch) + ",";
  }
  body += "\"wifiConnected\":"    + String(wifiConnected ? "true" : "false");
  // Optional fields
  if (appliedPlanName.length() > 0) {
    body += ",\"appliedPlanName\":\"" + appliedPlanName + "\"";
  }
  if (scheduleAppliedAt > 0) {
    body += ",\"scheduleAppliedAt\":" + String((uint32_t)scheduleAppliedAt);
  }
  body += ",\"sensorDataOk\":" + String(status.sensorDataOk ? "true" : "false");
  body += "}";

  int code = httpRequest("PUT", "/api/status", body);
  if (code != 200 && code != 204) {
    Serial.printf("[API] Status POST failed (HTTP %d)\n", code);
  } else {
    lastPostedStatusSignature = signature;
    lastStatusPostMs = millis();
  }
}

void logPumpCycle(float durationSec, bool flowed, String fault) {
  LogEntry entry;
  entry.timestamp       = getCurrentEpoch();
  entry.durationSeconds = (uint16_t)durationSec;
  entry.flowed          = flowed;
  fault.toCharArray(entry.fault, sizeof(entry.fault));

  if (!wifiConnected || !postLogEntryToAPI(entry)) {
    pushOfflineLog(entry);
  }
}

bool postLogEntryToAPI(const LogEntry& entry) {
  String body = "{";
  body += "\"timestamp\":"       + String((uint32_t)entry.timestamp) + ",";
  body += "\"durationSeconds\":" + String(entry.durationSeconds) + ",";
  body += "\"flowed\":"          + String(entry.flowed ? "true" : "false") + ",";
  body += "\"fault\":\""         + String(entry.fault) + "\"";
  body += "}";

  int code = httpRequest("POST", "/api/pump-log", body);
  if (code == 200 || code == 201) return true;
  Serial.printf("[API] Log POST failed (HTTP %d)\n", code);
  return false;
}

