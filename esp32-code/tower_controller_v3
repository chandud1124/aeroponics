struct PumpCycleProfile {
  int intervalMinutes;
  int durationSeconds;
};

bool shouldLightBeOnBySchedule(time_t epochNow) {
  if (!schedule.lightEnabled || !schedule.enabled) {
    return false;
  }

  struct tm localTime = {};
  if (!localtime_r(&epochNow, &localTime)) {
    return false;
  }

  const bool inWindow = localTime.tm_hour >= schedule.lightStartHour && localTime.tm_hour < schedule.lightEndHour;
  if (!inWindow) {
    return false;
  }

  if (sensors.lightValid) {
    return sensors.isDark;
  }

  return true;
}

PumpCycleProfile getActivePumpProfile(time_t epochNow) {
  struct tm localTime = {};
  if (epochNow > 0 && localtime_r(&epochNow, &localTime)) {
    bool isDay = localTime.tm_hour >= schedule.startHour && localTime.tm_hour < schedule.endHour;
    if (isDay) {
      return { schedule.dayIntervalMinutes, schedule.dayDurationSeconds };
    }
    return { schedule.nightIntervalMinutes, schedule.nightDurationSeconds };
  }

  return { schedule.intervalMinutes, schedule.durationSeconds };
}

